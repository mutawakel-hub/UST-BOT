# ============================================
# UST Central Bot - Environment Variables Example
# ============================================
# انسخ هذا الملف إلى: .env (للاستخدام المحلي)
# وأدخل قيمك الفعلية بدل العناصر النائبة
# ============================================

# ====== Cloudflare (مطلوب للنشر) ======
CLOUDFLARE_API_TOKEN=cfut_your_cloudflare_api_token_here
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
WORKERS_SUBDOMAIN=your_workers_subdomain
# مثال: atow73768 (يُستخدم لإنشاء روابط: https://ust-student-bot.<subdomain>.workers.dev)

# ====== Telegram Bot Tokens (مطلوب) ======
# احصل عليها من @BotFather
STUDENT_BOT_TOKEN=1234567890:AAH-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ADMIN_BOT_TOKEN=1234567891:AAH-yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy

# ====== أسماء الـ Bots (مطلوب) ======
STUDENT_BOT_USERNAME=ust_student_bot
ADMIN_BOT_USERNAME=ust_admin_bot

# ====== PDF Server URL (اختياري - للملفات التجريبية) ======
# يُستخدم في الـ Mockup لإرسال ملف PDF عند التحميل
PDF_SERVER_URL=https://ust-pdf-server.your-subdomain.workers.dev/sample.pdf

# ====== بيئة التشغيل ======
ENVIRONMENT=mockup
# القيم الممكنة: mockup | development | production

# ====== للمستقبل: Supabase (للمرحلة 2) ======
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ====== للمستقبل: Rate Limiting KV (للمرحلة 4) ======
# KV_NAMESPACE_ID=your_kv_namespace_id
